# Track reinforcement learning model binaries with Git LFS
models/*.zip filter=lfs diff=lfs merge=lfs -text
models/*.pkl filter=lfs diff=lfs merge=lfs -text
models/*.pt filter=lfs diff=lfs merge=lfs -text
models/*.h5 filter=lfs diff=lfs merge=lfs -text

# Standardize text formatting for source code files
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.js text eol=lf
*.jsx text eol=lf
